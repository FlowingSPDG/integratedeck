{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "integratedeck",
  "version": "0.1.0",
  "identifier": "app.integratedeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../src-ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../src-ui",
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "integratedeck",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; img-src 'self' data: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  },
  "plugins": {}
}
