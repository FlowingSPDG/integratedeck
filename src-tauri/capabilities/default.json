{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default integratedeck capabilities",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:allow-internal-toggle-devtools",
    "shell:allow-spawn",
    "shell:allow-execute",
    "allow-app-commands"
  ]
}
